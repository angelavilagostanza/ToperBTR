<?xml version="1.0" encoding="UTF-8"?>
<!--
  Esta carpeta es un endpoint maquina-a-maquina (ver descargar.asp), no una pagina para
  navegador. El web.config raiz de la app (app/web.config) tiene:

    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Replace">
      ...redirige 401/403/404/500 a /errors/error.asp (HTML)...

  "existingResponse=Replace" se hereda por defecto y sustituiria CUALQUIER respuesta que
  escriba descargar.asp en esos codigos de estado por la pagina HTML de error - incluido
  el 403.7 que genera el propio IIS al rechazar un certificado de cliente invalido. Este
  override deja la respuesta del script intacta.

  Checklist del administrador de IIS para esta ruta: ver
  docs/12-endpoint-intercambio-operadores.md en la raiz del repositorio.
-->
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
