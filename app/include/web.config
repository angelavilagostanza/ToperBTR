<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bloquea acceso HTTP directo a /include/ (solo lectura como SSI, nunca via HTTP).
  En pipeline Integrated (IIS 7+): <handlers><clear/> elimina el manejador -> 404.
  En pipeline Classic: la proteccion real debe configurarse via IIS Manager
  (URL Authorization o filtro ISAPI).
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
    </handlers>
  </system.webServer>
</configuration>
