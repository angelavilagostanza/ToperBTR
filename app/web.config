<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracion IIS 7+ para ToperBTR (Classic ASP + MySQL ODBC).
  El session timeout lo gestiona global.asa (Session.Timeout), no este fichero.
-->
<configuration>
  <system.webServer>

    <directoryBrowse enabled="false" />

    <!-- errorMode=DetailedLocalOnly: stack traces solo desde localhost.
         El original tenia "Detailed" (exponía detalles de error a todos). -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Replace">
      <remove statusCode="401" subStatusCode="-1" />
      <remove statusCode="403" subStatusCode="-1" />
      <remove statusCode="404" subStatusCode="-1" />
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="401" path="/errors/error.asp?msg=sinpermiso"   responseMode="Redirect" />
      <error statusCode="403" path="/errors/error.asp?msg=sinpermiso"   responseMode="Redirect" />
      <error statusCode="404" path="/errors/error.asp?msg=noencontrado" responseMode="Redirect" />
      <error statusCode="500" path="/errors/error.asp"                   responseMode="Redirect" />
    </httpErrors>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <!-- PRO ya tiene SSL/HTTPS activo (confirmado 2026-10-29, bloqueante #10 de
             docs/14-despliegue-produccion.md) - HSTS activada. OJO: una vez el
             navegador la recibe, recuerda forzar HTTPS en este dominio durante
             max-age (1 año) aunque el sitio dejara de tener SSL - no es reversible
             a corto plazo, solo activar cuando se este seguro de que SSL es permanente. -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- CSP "basica": bloquea scripts/estilos/objetos cargados desde otro origen y
             iframes ajenos (mitiga el impacto de cualquier XSS que se nos escape, como
             A4/M1 ya corregidos, aunque no sean los unicos), SIN romper el <script>
             inline y los onclick="..." que ya usa la app hoy en varias paginas
             (auditoria/buscar.asp, bloqueos/bloqueo.asp, ficheros/buscar.asp,
             incidencias/buscar.asp, solicitudes/consulta.asp, entre otras) - por eso
             lleva 'unsafe-inline' en script-src/style-src. Pendiente de mejora futura:
             mover ese JS inline a ficheros .js externos y quitar 'unsafe-inline', que
             si cerraria el hueco de XSS por completo (no se hace ahora para no mezclar
             objetivos). Probado en pre antes de desplegar, con el precedente de que esta
             misma seccion del web.config ya tumbo la app entera dos veces (hallazgo A5). -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-ancestors 'self'; base-uri 'self'" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering allowDoubleEscaping="false">
        <requestLimits maxUrl="4096" maxAllowedContentLength="4194304" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
